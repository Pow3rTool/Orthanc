# Orthanc deployment config — copy to .env and fill in. .env is gitignored.
# Nothing site-specific should live in source; it all comes from here.

# --- Django core ---
ORTHANC_SECRET_KEY=change-me-to-a-long-random-string
ORTHANC_DEBUG=false
# Comma-separated. The public hostnames this instance answers on.
ORTHANC_ALLOWED_HOSTS=orthanc.example.com,pow3rtool.example.com
# Comma-separated https origins for CSRF (the same public hosts).
ORTHANC_CSRF_TRUSTED_ORIGINS=https://orthanc.example.com

# --- Database (Postgres) ---
ORTHANC_DB_NAME=orthanc
ORTHANC_DB_USER=orthanc
ORTHANC_DB_PASSWORD=change-me
ORTHANC_DB_HOST=db.example.com
ORTHANC_DB_PORT=5432

# --- PKI / enrollment ---
ORTHANC_CA_DIR=ca/pki
ORTHANC_TRUST_DOMAIN=pow3rtool
ORTHANC_JOIN_TOKEN_TTL_MINUTES=60
ORTHANC_NODE_CERT_TTL_HOURS=720

# Public XConnect base URL serving /bootstrap — used to render the console
# join-token install one-liner. Leave blank to show a placeholder host.
ORTHANC_BOOTSTRAP_URL=https://xconnect.example.com

# --- Entra / SSO (MSAL confidential client, cert credential) ---
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_CERT_THUMBPRINT=ABCDEF0123456789ABCDEF0123456789ABCDEF01
AZURE_CLIENT_CERT_KEY=/path/to/sso-client.key
AZURE_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000
AZURE_REDIRECT_URI=https://orthanc.example.com/oidc/callback
AZURE_SCOPES=User.Read

# --- OBO token re-validation at the control plane (run_control) ---
# Orthanc INDEPENDENTLY verifies the OBO token XConnect forwards, so a compromised
# XConnect can't fabricate a principal. OBO_AUDIENCE is the XConnect *API* app's
# audience (its app-id GUID or api://<guid> URI) — NOT the SSO app above.
# Enforcement auto-enables once OBO_AUDIENCE is set; run_control refuses to start
# if it's on but tenant/audience are missing. Set ORTHANC_OBO_VALIDATE_TOKEN=false
# only for local dev (then the control plane trusts XConnect's word — not for prod).
ORTHANC_OBO_AUDIENCE=
ORTHANC_OBO_TENANT_ID=                       # defaults to AZURE_TENANT_ID
ORTHANC_OBO_REQUIRED_SCOPE=tunnel.invoke
# ORTHANC_OBO_VALIDATE_TOKEN=true            # defaults true once OBO_AUDIENCE is set
